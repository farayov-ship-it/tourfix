# Local SQLite (faqat provider = "sqlite" bo‘lsa):
# DATABASE_URL="file:./dev.db"

# Production / Vercel: Prisma Postgres
# Agar pooled host ishlamasa — db.prisma.io (direct) ishlating + connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require&connection_limit=1"

AUTH_SECRET="generate-a-long-random-string"

# Production domen (Vercel URL yoki custom)
AUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Optional fallbacks (prefer Admin UI):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# MEDIA_DRIVER=local
