# Local SQLite (faqat provider = "sqlite" bo‘lsa):
# DATABASE_URL="file:./dev.db"

# Production / Vercel: Prisma Postgres (pooled host — serverless uchun)
# DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require&connection_limit=1"
# Migratsiya uchun (faqat prisma db push / migrate):
# DIRECT_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require&connection_limit=1"

AUTH_SECRET="generate-a-long-random-string"

# Production domen (Vercel URL yoki custom)
AUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Optional fallbacks (prefer Admin UI):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# MEDIA_DRIVER=local
